---
import CtaButton from "../../components/index/CtaButton.astro"
import Phone from "../../assets/screenshots/ios.png"
import Footer from "../../components/layout/Footer.astro"
import Navbar from "../../components/layout/Navbar.astro"
import MarketingLayout from "../../layouts/MarketingLayout.astro"
import Consts from "../../lib/consts"
---

<MarketingLayout title="Download Stoat for iOS" backgroundColor="var(--color-bg-darker)">
    <Navbar />
    <div class="spacer"></div>
    <div class="lr-pad">
        <div class="with-phone">
            <div class="main">
                <h1 class="main-heading">Get Stoat for iOS</h1>
                <p class="main-heading-sub">
                    <span class="block-sm">No matter where you are. </span>
                    No matter what device you're on.<br />
                    <span class="block-sm">Stoat is here for you.</span>
                    Works on iPhone and iPad.<br />
                    <span class="coming-soon">
                        A native iOS app is in the works. Until it ships, the
                        web app puts Stoat on your home screen, and works just like an app.
                    </span>
                </p>
                <ol class="steps">
                    <li>Open the Stoat web app in Safari.</li>
                    <li>Tap the Share button.</li>
                    <li>Select "Add to Home Screen", then tap "Add".</li>
                </ol>
                <CtaButton
                    href={Consts.WEB_APP_URL}
                    label="Open Web App"
                    primary
                />
            </div>
            <img
                src={Phone.src}
                alt="Screenshot of Stoat on an iPhone"
                class="phone"
            />
        </div>
    </div>
    <Footer />
</MarketingLayout>
<style lang="scss">
    .lr-pad {
        max-width: min(130ch, 90vw);
        margin: 0 auto;
        display: grid;
        gap: 4rem;
        padding-bottom: 4rem;
    }

    .spacer {
        height: 12rem;

        @media (max-width: 768px) {
            height: 2rem;
        }
    }

    .with-phone {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;

        @media (max-width: 768px) {
            flex-direction: column-reverse;
            align-items: center;
            gap: 2rem;
        }
    }

    .main {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        margin: 0;
        text-align: left;

        @media (max-width: 768px) {
            align-items: center;
            text-align: center;
        }
    }

    .main-heading {
        font-size: 4rem;
        font-weight: 750;
        color: white;
        line-height: 1;
        margin: 0;
    }

    .main-heading-sub {
        font-size: 1.5rem;
        color: white;
        opacity: 0.7;
        line-height: 1.5;

        span.coming-soon {
            display: block;
            margin-top: 1rem;
            font-size: 0.7em;
            opacity: 0.8;
        }

        @media (max-width: 768px) {
            font-size: 1.25rem;

            span.block-sm {
                display: block;
            }

            span.coming-soon {
                font-size: 1rem;
            }
        }
    }

    .steps {
        font-size: 1.1rem;
        color: white;
        opacity: 0.7;
        line-height: 1.8;
        margin: 0 0 2rem;
        padding-left: 1.25rem;

        @media (max-width: 768px) {
            text-align: left;
        }
    }

    .phone {
        width: min(30vw, 400px);
        height: auto;

        @media (max-width: 768px) {
            width: 50%;
            height: auto;
        }
    }
</style>
