---
import MarketingLayout from "../../layouts/MarketingLayout.astro"
import Navbar from "../../components/layout/Navbar.astro"
import Footer from "../../components/layout/Footer.astro"
import * as API from "../../lib/changelogs"

import { micromark } from "micromark"
import { gfm, gfmHtml } from 'micromark-extension-gfm'
import ContentStyles from "../../components/layout/ContentStyles.astro"

const { id } = Astro.params

if (!id || id === "latest") {
    return Astro.rewrite("/404")
}

const changelogEntry = await API.fetchChangelog(id)

if (changelogEntry === null) {
    return Astro.rewrite("/404")
}

const markdown = micromark(changelogEntry.markdown_content, {
  allowDangerousHtml: true,
  extensions: [gfm()],
  htmlExtensions: [gfmHtml()]
})
---

<MarketingLayout title={changelogEntry.title} backgroundColor="var(--color-bg-primary)">
    <Navbar />
    <div class="spacer"></div>
    <div class="lr-pad">
        <article>
            <h1>{changelogEntry.title}</h1>
            <h2>Update from {new Date(changelogEntry.published_at).toLocaleDateString("en-GB", {
                year: "2-digit",
                month: "long",
                day: "numeric",
            })}</h2>
            <ContentStyles class="content" set:html={markdown} />
        </article>
    </div>
    <Footer />
</MarketingLayout>

<style lang="scss">
    .lr-pad {
        max-width: min(130ch, 90vw);
        margin: 0 auto;
        margin-bottom: 4rem;
    }

    .spacer {
        height: 10rem;

        @media (max-width: 768px) {
            height: 2.5rem;
        }
    }

    article {
        h1 {
            font-size: 6rem;
            font-weight: 900;
            margin: 0;
            padding: 0;
            line-height: 1;

            @media (max-width: 768px) {
                font-size: 4rem;
                line-height: 1;
            }
        }

        h2 {
            font-size: 1.2rem;
            margin-top: 1rem;
            margin-bottom: 3rem;
            opacity: 0.7;
        }
    }
</style>
