---
import Navbar from "../components/layout/Navbar.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Footer from "../components/layout/Footer.astro";
import Cta from "../components/index/Cta.astro";
---

<MarketingLayout title="About Stoat" backgroundColor="var(--color-bg-primary)">
  <Navbar />

  <section class="hero">
    <h1>We build Stoat.</h1>
    <p>
      An open-source chat platform for communities that want
      something better.
    </p>
  </section>

  <section class="story">
    <div class="story-inner">
      <h2>Why we're here</h2>
      <p>
        Most chat platforms ship features to move metrics, not because
        they're actually useful. Your attention is the product. Your data
        is the revenue stream. We got tired of it.
      </p>
      <p>
        Stoat started in 2021 as a simple idea: build a chat app that
        works well and doesn't have an ulterior motive. Open source from
        day one, no ads, no hidden agenda. Just software that works for
        the people using it.
      </p>
    </div>
  </section>

  <section class="principles">
    <div class="principles-grid">
      <div class="principle-card">
        <h3>Open source</h3>
        <p>
          Every line of code is public. You can read it, audit it, fork it,
          or contribute to it. The software that handles your conversations
          shouldn't be a black box.
        </p>
      </div>
      <div class="principle-card">
        <h3>Privacy by default</h3>
        <p>
          We don't sell your data. Your messages belong to you.
          That's not a feature, it's the bare minimum, and
          most platforms don't even do that.
        </p>
      </div>
      <div class="principle-card">
        <h3>Built to be yours</h3>
        <p>
          Stoat is designed to get out of your way and
          let you make it work however you need it to.
          Your tools should bend to you, not the other way around.
        </p>
      </div>
    </div>
  </section>

  <section class="numbers">
    <div class="numbers-grid">
      <div class="number">
        <span class="number-value">1M+</span>
        <span class="number-label">Users</span>
      </div>
      <div class="number-divider"></div>
      <div class="number">
        <span class="number-value">150k+</span>
        <span class="number-label">Lines of code</span>
      </div>
      <div class="number-divider"></div>
      <div class="number">
        <span class="number-value">100%</span>
        <span class="number-label">Open source</span>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <h2>That's us. Want in?</h2>
    <Cta />
  </section>

  <Footer />
</MarketingLayout>

<style lang="scss">
  .hero {
    text-align: center;
    padding: 14rem 2rem 8rem;
    max-width: 720px;
    margin: 0 auto;

    h1 {
      font-size: 4.5rem;
      font-weight: 800;
      margin: 0 0 1.5rem;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    p {
      font-size: 1.35rem;
      line-height: 1.6;
      opacity: 0.7;
      margin: 0;
      font-weight: 500;
    }

    @media (max-width: 768px) {
      padding: 10rem 1.5rem 5rem;

      h1 {
        font-size: 2.8rem;
      }

      p {
        font-size: 1.15rem;
      }
    }
  }

  .story {
    max-width: min(90ch, 90vw);
    margin: 0 auto;
    padding: 6rem 2rem;

    h2 {
      font-size: 1.1rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--color-primary);
      margin: 0 0 2.5rem;
    }

    p {
      font-size: 1.35rem;
      line-height: 1.8;
      opacity: 0.85;
      margin: 0 0 1.75rem;
      font-weight: 450;

      &:last-child {
        margin-bottom: 0;
      }
    }
  }

  .principles {
    max-width: min(130ch, 90vw);
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
    }
  }

  .principle-card {
    padding: 2.5rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);

    h3 {
      font-size: 1.25rem;
      font-weight: 700;
      margin: 0 0 0.75rem;
    }

    p {
      font-size: 1rem;
      line-height: 1.7;
      opacity: 0.65;
      margin: 0;
      font-weight: 450;
    }
  }

  .numbers {
    max-width: min(130ch, 90vw);
    margin: 0 auto;
    padding: 6rem 2rem;
  }

  .numbers-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4rem;

    @media (max-width: 768px) {
      flex-direction: column;
      gap: 2.5rem;
    }
  }

  .number {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .number-value {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .number-label {
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.45;
  }

  .number-divider {
    width: 1px;
    height: 3.5rem;
    background: rgba(255, 255, 255, 0.1);

    @media (max-width: 768px) {
      width: 3rem;
      height: 1px;
    }
  }

  .cta-section {
    text-align: center;
    padding: 4rem 2rem 10rem;

    h2 {
      font-size: 2.5rem;
      font-weight: 750;
      margin: 0;
      line-height: 1.2;

      @media (max-width: 768px) {
        font-size: 2rem;
      }
    }
  }
</style>
