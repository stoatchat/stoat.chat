---
import Cta from "./Cta_S.astro"
import HeroTagline from "../../assets/scalable/HeroTagline.png"
import HeroTagline2x from "../../assets/scalable/HeroTagline@2x.png"
import HeroTagline3x from "../../assets/scalable/HeroTagline@3x.png"
---

<header>
    <img
        src={HeroTagline.src}
        srcset={`${HeroTagline.src} 1x, ${HeroTagline2x.src} 2x, ${HeroTagline3x.src} 3x`}
        alt="Cut the cord. Get on Stoat."
        class="tagline"
    />
    <Cta />
</header>
<style lang="scss">
    header {
        padding-top: 10rem;
    }

    .tagline {
        width: min(90vw, 800px);
        height: auto;
        display: block;
        margin: 2rem auto 4rem auto;
        user-select: none;
        pointer-events: none;
    }

    p {
        font-size: 1.5rem;
        max-width: 600px;
        margin: 0 auto 4rem auto;
        text-align: center;
        opacity: 0.9;
        line-height: 1.25;
    }
</style>
