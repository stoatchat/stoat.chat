---
import Cta from "./Cta_S.astro"
import productImg from "../../assets/index/product.png"
---

<header>
    <div class="hero-card">
        <div class="text-part">
            <h1 class="tagline">Find your<br/>community.</h1>
            <h2 class="subtagline">Stoat is the chat app for friends and communities that finally works the way you always wished it would.</h2>
            <div class="cta">
                <Cta/>
            </div>
        </div>
        <img src={productImg.src} alt="Stoat desktop client" width={productImg.width} height={productImg.height} />
    </div>
</header>
<style lang="scss">
    header {
        padding-top: 10rem;
        width: min(90vw, 1400px);
        margin: 0 auto;
    }

    .hero-card {
        border-radius: 2rem;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow:
            0 16px 64px rgba(0, 0, 0, 0.4),
            0 0 0 1px rgba(255, 255, 255, 0.04);

        @media screen and (max-width: 768px) {
            border: none;
            box-shadow: none;
            border-radius: 0;
        }
    }

    .hero-card img {
        width: 100%;
        height: auto;
        display: block;
        border-radius: .7rem;
    }

    .text-part {
        display: flex;
        flex-direction: column;
        margin: 1rem;
        padding-top: 2rem;

        @media (min-width: 768px) {
            margin: 3em;
        }
    }

    .tagline {
        line-height: 1em;
        margin: 0;
        font-size: 3rem;
        font-weight: 900;

        @media (min-width: 768px) {
            font-size: 4.5rem;
        }
    }

    .subtagline {
        opacity: 0.6;
        font-weight: 400;
        letter-spacing: 0.05em;
        max-width: 40ch;
    }

    @media (max-width: 768px) {
        header {
            padding-top: 2rem;
        }

        .hero-card {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .text-part {
            align-items: center;
            text-align: center;
        }
    }

    .cta {
        width: fit-content;
    }
</style>
