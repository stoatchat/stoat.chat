---
import type { Store } from "../../lib/decl"
import DownloadButton from "./DownloadButton.astro"

interface Props {
    name: string
    stores: Store[]
    beta?: boolean
}

const { name, stores, beta = false } = Astro.props
---

<div class="dl-tile">
    <h2>{name} {beta && <span class="beta-badge">Early Access</span>}</h2>
    <slot name="description" />
    <div class="grow"></div>
    <div class="cta">
        {
            stores.map((store) => (
                <DownloadButton href={store.url} primary={store.primary}>
                    {store.name}
                </DownloadButton>
            ))
        }
    </div>
</div>
<style lang="scss">
    .dl-tile {
        padding: 2rem;
        border-radius: 1rem;
        background-color: rgb(255 255 255 / 5%);
        display: flex;
        flex-direction: column;

        .grow {
            flex-grow: 1;
        }

        .cta {
            padding-top: 1rem;
            display: flex;
            flex-direction: row;
            gap: .5rem;
            flex-wrap: wrap;
        }

        h2 {
            font-size: 1.5rem;
            font-weight: 530;
            letter-spacing: 0.03em;
            color: white;
            margin: 0;
            display: flex;
            gap: .5rem;
            flex-wrap: wrap;
            align-items: center;
            flex-direction: row;
        }

        .beta-badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.07em;
            border-radius: 9999px;
            background-color: var(--color-bg-lightest);
            color: white;
            align-self: center;
        }
    }
</style>
