---
import Wordmark from "../../assets/Stoat_White.svg"
import NavLinks from "./NavLinks.astro"
import MenuIcon from "../../assets/apache2/menu.svg"
---

<nav class="site-navbar">
    <div class="nav-inner">
        <a href="/">
            <img src={Wordmark.src} alt="Stoat" class="wordmark" />
        </a>
        <div class="links desktop">
            <NavLinks />
        </div>
        <div class="mobile">
            <button aria-label="Open mobile menu">
                <img src={MenuIcon.src} alt="Menu" />
            </button>
        </div>
    </div>
    <div id="mobile-menu" class="mobile-menu links">
        <NavLinks />
    </div>
</nav>

<style lang="scss" is:global>
    nav.site-navbar {
        position: fixed;
        top: 2rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1000;
        width: fit-content;
        max-width: calc(100vw - 2rem);

        .nav-inner {
            padding: 1rem 2rem;
            display: flex;
            gap: 2rem;
            align-items: center;
            border-radius: 9999px;
            overflow: hidden;
            position: relative;
            z-index: 1001;

            background: rgba(42, 35, 58, 0.7);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);

            transition: background 0.3s var(--easing);

            &:hover {
                background: rgba(42, 35, 58, 0.8);
            }

            a {
                padding: 0;
                margin: 0;
                display: grid;
                place-items: center;
            }

            .wordmark {
                height: 35px;
                width: auto;
            }
        }

        .links {
            display: flex;
            gap: 1.5rem;
            align-items: center;
            flex-shrink: 0;

            a {
                color: white;
                text-decoration: none;
                font-weight: 500;
                font-size: 1rem;
                transition: color 0.2s var(--easing);
                white-space: nowrap;

                &:hover {
                    color: var(--color-primary);
                }
            }
        }

        .wordmark {
            flex-shrink: 0;
        }

        .mobile > button {
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;

            img {
                width: 2rem;
                height: 2rem;
                filter: invert(1);
            }
        }

        @keyframes slide-down {
            from {
                transform: translateY(-100%);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        @keyframes slide-up {
            from {
                transform: translateY(0);
                opacity: 1;
            }
            to {
                transform: translateY(-100%);
                opacity: 0;
            }
        }

        .mobile-menu {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            width: 100%;

            background: rgba(42, 35, 58, 0.95);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow:
                0 8px 32px 0 rgba(0, 0, 0, 0.37),
                inset 0 1px 0 0 rgba(255, 255, 255, 0.1);

            padding: 0;
            display: none;
            flex-direction: column;
            gap: 0;
            z-index: 999;
            box-sizing: border-box;

            &.open {
                display: flex;
                animation: slide-down 0.3s cubic-bezier(0.22, 1, 0.36, 1) forwards;
            }

            &.closing {
                display: flex;
                animation: slide-up 0.3s cubic-bezier(0.64, 0, 0.78, 0) forwards;
            }

            a {
                display: block;
                padding: 1rem 1.5rem;
                width: 100%;
                box-sizing: border-box;
                transition: background-color 0.2s var(--easing);

                &:hover {
                    background-color: rgba(255, 255, 255, 0.1);
                }
            }
        }

        @media (max-width: 768px) {
            & {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                transform: none;
                width: 100%;
                max-width: 100%;
                overflow: visible;
            }

            .nav-inner {
                padding: 1rem 1.5rem;
                gap: 1rem;
                justify-content: space-between;
                width: 100%;
                max-width: 100%;
                border-radius: 0;
                border: none;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                background: rgba(42, 35, 58, 0.95);
                box-sizing: border-box;
            }

            .desktop {
                display: none;
            }

            .wordmark {
                height: 32px !important;
            }

            .mobile-menu {
                padding-top: calc(64px + calc(1rem - 9px));

                a {
                    font-size: 1.1rem;
                    padding: 1rem 1.5rem;
                }
            }
        }

        @media (min-width: 769px) {
            .mobile {
                display: none;
            }

            .mobile-menu {
                display: none !important;
            }
        }
    }

    @media (max-width: 768px) {
        body {
            padding-top: calc(32px + 2rem + 1px);
        }
    }
</style>

<script>
    const menu = document.querySelector<HTMLElement>(".mobile-menu")!
    const button = document.querySelector<HTMLElement>(".mobile > button")!
    let isAnimating = false

    button.addEventListener("click", (e) => {
        e.stopPropagation()

        if (isAnimating) return

        if (menu.classList.contains("open")) {
            isAnimating = true
            menu.classList.remove("open")
            menu.classList.add("closing")

            setTimeout(() => {
                menu.classList.remove("closing")
                isAnimating = false
            }, 300)
        } else if (!menu.classList.contains("closing")) {
            isAnimating = true
            menu.classList.remove("closing")
            menu.classList.add("open")

            setTimeout(() => {
                isAnimating = false
            }, 300)
        }
    })

    document.addEventListener("click", (e) => {
        const navbar = document.querySelector<HTMLElement>(".site-navbar")!

        if (!navbar.contains(e.target as Node) && menu.classList.contains("open") && !isAnimating) {
            isAnimating = true
            menu.classList.remove("open")
            menu.classList.add("closing")

            setTimeout(() => {
                menu.classList.remove("closing")
                isAnimating = false
            }, 300)
        }
    })
</script>
