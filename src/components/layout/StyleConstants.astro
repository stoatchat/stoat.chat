---
import "@fontsource/fragment-mono/400.css"
import "../../assets/satoshi/satoshi.css"

export const COLOR_PRIMARY = "#00d8ff" // Also change below
---

<style is:global lang="scss">
    :root {
        --typeface-primary: "Satoshi", sans-serif;
        --typeface-primary-ffs: "ss02" 1, "ss03" 1;
        --typeface-mono: "Fragment Mono", monospace;
        --easing: cubic-bezier(0.33, 1, 0.68, 1);
        -webkit-tap-highlight-color: transparent;

        // Brand colors
        --color-primary: #00d8ff;
        --color-secondary: #00ffd8;

        // Background colors
        --color-bg-darkest: #110E17;
        --color-bg-darker: #191523;
        --color-bg-dark: #221C2E;
        --color-bg-primary: #2A233A;
        --color-bg-light: #322A46;
        --color-bg-lighter: #3B3151;
        --color-bg-lightest: #43385D;

        // Primary color shades
        --color-primary-100: #E0F8FF;
        --color-primary-200: #A3ECFF;
        --color-primary-300: #5CE1FF;
        --color-primary-400: #00C0E0;
        --color-primary-700: #007A91;

        // Secondary color shades
        --color-secondary-400: #00D6B5;
        --color-secondary-700: #00806C;

        // Greyscale
        --color-gray-100: #0A0A0A;
        --color-gray-200: #1A1A1A;
        --color-gray-300: #2A2A2A;
        --color-gray-400: #404040;
        --color-gray-500: #666666;
        --color-gray-600: #888888;
        --color-gray-700: #A8A8A8;
        --color-gray-800: #C4C4C4;
        --color-gray-900: #E0E0E0;
        --color-gray-1000: #F5F5F5;

        // User status colors
        --color-status-online: #3BA55C;
        --color-status-idle: #FAA61A;
        --color-status-dnd: #ED4245;
        --color-status-focus: #5865F2;
        --color-status-offline: #747F8D;

        // Auxiliary for dataviz
        --color-chart-1: #FF6B35;
        --color-chart-2: #FF006E;
        --color-chart-3: #00D9FF;
        --color-chart-4: #FFD23F;
        --color-chart-5: #00FFB7;

        // Semantic colors
        --color-success: var(--color-status-online);
        --color-warning: var(--color-status-idle);
        --color-danger: var(--color-status-dnd);
    }
    
    @supports (font-variation-settings: normal) {
        :root {
            --typeface-primary: "SatoshiVariable", sans-serif;
            font-optical-sizing: auto;
        }
    }
</style>
