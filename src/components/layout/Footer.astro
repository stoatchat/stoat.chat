---
import WordmarkWhite from "../../assets/Stoat_White.svg"
import { getStatusPage, impactIntoString } from "../../lib/status";
import StatusChip from "./StatusChip.astro";

const statusPage = await getStatusPage()
---

<footer>
    <div class="copyright-section">
        <img src={WordmarkWhite.src} alt="Stoat" class="wordmark" />
        <div class="copyright">
            © Revolt Platforms Ltd, {new Date().getFullYear()}
        </div>
        {statusPage && <StatusChip page={statusPage} />}
    </div>
    <div class="links-section">
        <div class="links">
            <span>Stoat App</span>
            <a href="/download">Download for Desktop</a>
            <a href="/download/android">Download for Android</a>
            <a href="/download/ios">Download for iOS and iPadOS</a>
            <a href="https://support.stoat.chat/" target="_blank">Support</a>
        </div>
        <div class="links">
            <span>Developers</span>
            <a href="https://github.com/stoatchat/" target="_blank"
                >Source Code</a
            >
            <a href="https://developers.stoat.chat/" target="_blank"
                >Documentation</a
            >
            <a href="https://translate.stoat.chat/" target="_blank"
                >Help Translate</a
            >
        </div>
        <div class="links">
            <span>Team</span>
            <a href="/about">About</a>
            <a href="/updates">Blog and Changelogs</a>
            <a href="/brand">Brand Assets and Press Kit</a>
            <a href="https://support.stoat.chat/contact" target="_blank"
                >Contact</a
            >
        </div>
        <div class="links">
            <span>Stoat on Socials</span>
            <a href="https://bsky.app/profile/stoat.chat" target="_blank"
                >Bluesky</a
            >
            <a href="https://reddit.com/r/stoatchat" target="_blank">Reddit</a>
            <a href="https://stt.gg/Testers" target="_blank">Stoat Server</a>
        </div>
        <div class="links">
            <span>Legal</span>
            <a href="/legal/community-guidelines">Community Guidelines</a>
            <a href="/legal/terms">Terms of Service</a>
            <a href="/legal/privacy">Privacy Policy</a>
            <a href="/legal/imprint">Imprint</a>
        </div>
    </div>
</footer>

<style lang="scss">
    footer {
        color: white;
        padding: 3rem;
        max-width: min(90vw, 1300px);
        margin: 2rem auto;
        border-radius: 2rem;
        font-weight: 500;
        letter-spacing: 0.02rem;

        background: rgba(42, 35, 58, 0.7);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        border: 1px solid rgba(255, 255, 255, 0.1);

        transition:
            padding 0.5s var(--easing),
            flex-direction 0.5s var(--easing);

        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-start;

        @media (max-width: 1600px) {
            padding: 3rem 2rem;
        }
        @media (max-width: 1350px) {
            flex-direction: column;
            justify-content: center;
            gap: 2rem;
        }
        @media (max-width: 768px) {
            max-width: calc(100% - 1rem);
            margin: 1rem 0.5rem;
            border-radius: 1rem;
            padding: 2rem 1.5rem;
        }

        .copyright-section {
            .wordmark {
                height: 50px;
                width: auto;
            }

            .copyright {
                font-size: 0.9rem;
                margin-top: 1rem;
                opacity: 0.75;
            }
        }

        .links-section {
            font-size: 0.9rem;
            display: flex;
            flex-direction: row;
            justify-content: flex-end;
            align-items: flex-start;
            gap: 2rem;

            @media (max-width: 1350px) {
                flex-wrap: wrap;
                justify-content: flex-start;
            }

            @media (max-width: 600px) {
                flex-direction: column;
                justify-content: flex-start;

                .links > span {
                    font-weight: 800 !important;
                    margin-bottom: 0 !important;
                }
            }

            .links {
                display: flex;
                flex-direction: column;
                gap: .75rem;

                span {
                    transition:
                        margin-bottom 0.2s var(--easing),
                        font-weight 0.2s var(--easing);
                    margin-bottom: 0.5rem;
                    opacity: 0.75;
                }

                a:link,
                a:visited {
                    color: inherit;
                    transition: color 0.2s var(--easing);
                    text-decoration: none;

                    &:hover {
                        color: var(--color-primary);
                    }
                }
            }
        }
    }
</style>
